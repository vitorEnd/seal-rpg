# Use somente valores do projeto Supabase exclusivo `seal-rpg`.
# Nunca reutilize URL ou chaves de outro projeto.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI
SUPABASE_PROJECT_REF=SEU_PROJECT_REF

# Somente no servidor. Necessária para o bootstrap/migração e para preservar
# login por nome de usuário sem expor e-mails. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_AQUI

# Usadas somente uma vez por `npm run supabase:bootstrap`. A senha nunca deve
# ser commitada e pode ser removida do Render depois que a conta for criada.
SEAL_RPG_ADMIN_EMAIL=seu-email@exemplo.com
SEAL_RPG_ADMIN_PASSWORD=troque-por-uma-senha-forte
SEAL_RPG_ADMIN_NAME=Administrador
SEAL_RPG_ADMIN_USERNAME=admin

# Mantido server-side para permitir a transição controlada dos adapters locais.
RPG_DATA_PROVIDER=supabase

# URL pública do Next.js (localhost no desenvolvimento; Render em produção).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
