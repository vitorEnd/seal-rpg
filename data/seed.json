  "campaigns": [
    {
      "id": "10000000-0000-4000-8000-000000000001",
      "name": "Operação Neptune",
      "slug": "operacao-neptune",
      "shortDescription": "Uma equipe SEAL é enviada ao Afeganistão para descobrir o próximo movimento da Al-Qaeda.",
      "description": "Em 2018, sinais fragmentados e movimentações incomuns apontam que uma célula da Al-Qaeda prepara uma operação de grande escala no Afeganistão. Uma equipe de fuzileiros de operações especiais SEAL é enviada sob uma missão não reconhecida oficialmente: entrar no país, localizar a rede responsável e descobrir o que está sendo planejado antes que seja tarde. Entre vales isolados, rotas clandestinas, aliados incertos e ordens que mudam no meio da operação, cada decisão pode comprometer a equipe — ou impedir uma ameaça que ninguém mais consegue enxergar.",
      "setting": "Afeganistão · 2018 · guerra assimétrica e operações clandestinas",
      "genre": "Military / Tactical RPG",
      "status": "draft",
      "coverImageUrl": "/art/neptune-hero.png",
      "coverImageStorageKey": null,
      "backgroundImageUrl": "/art/neptune-hero.png",
      "backgroundImageStorageKey": null,
      "primaryColor": "#e8792f",
      "secondaryColor": "#66737d",
      "startDate": null,
      "gameMasterUserId": "00000000-0000-4000-8000-000000000002",
      "storySummary": "A operação ainda não começou. O primeiro dossiê acompanha o encontro da equipe que será enviada ao Afeganistão.",
      "createdAt": "2026-08-23T12:00:00.000Z",
      "updatedAt": "2026-08-23T12:00:00.000Z"
    },
    {
      "id": "10000000-0000-4000-8000-000000000002",
      "name": "S.G.I.O. — Os Soldados Fantasmas de Verdrum",
      "slug": "sgio-soldados-fantasmas",
      "shortDescription": "Agentes extraordinários investigam desaparecimentos ligados a um experimento que aprendeu a sobreviver.",
      "description": "Mutantes, experimentos humanos e tecnologias impossíveis existem às margens do mundo conhecido. A Secretaria Geral de Intervenções Ocultas investiga, contém e, quando julga necessário, utiliza essas anomalias. Quando uma sequência de desaparecimentos na Escócia revela marcas de um protótipo biomecânico considerado morto, seis agentes com origens e capacidades extraordinárias são convocados. Entre segredos institucionais, poderes difíceis de controlar e uma criatura que aprende com cada encontro, eles precisarão se tornar uma equipe antes que o predador compreenda como derrotá-los.",
      "setting": "Escócia contemporânea · instalações clandestinas · fenômenos anormais",
      "genre": "Ação · suspense · super-heróis · ficção científica",
      "status": "recruiting",
      "coverImageUrl": "/art/sgio-hero.png",
      "coverImageStorageKey": null,
      "backgroundImageUrl": "/art/sgio-hero.png",
      "backgroundImageStorageKey": null,
      "primaryColor": "#e8b04a",
      "secondaryColor": "#52788f",
      "startDate": null,
      "gameMasterUserId": "00000000-0000-4000-8000-000000000002",
      "storySummary": "A operação ainda não começou. Rotinas controladas dentro da S.G.I.O. convergem quando desaparecimentos na Escócia revelam sinais de um projeto que deveria estar morto.",
      "createdAt": "2026-09-02T20:00:00.000Z",
      "updatedAt": "2026-09-02T20:00:00.000Z"
    }
  ],
  "campaignChapters": [
    {
      "id": "11000000-0000-4000-8000-000000000001",
      "campaignId": "10000000-0000-4000-8000-000000000001",
      "title": "O Prólogo",
      "slug": "o-prologo",
      "shortDescription": "Antes da primeira missão, quatro operadores precisam descobrir se conseguem confiar uns nos outros.",
      "description": "O início da história mostra como a equipe foi reunida, quais interesses colocaram cada integrante na operação e o primeiro contato entre pessoas treinadas para agir sozinhas, mas que agora dependerão umas das outras.",
